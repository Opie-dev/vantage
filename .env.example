# Copy to .env and adjust. .env is gitignored.
#
# Read by dbmate when you run it on the host (npm run db:*).
#
# NOTE the variable name. Docker Compose auto-loads this file for substitution,
# so calling it DATABASE_URL would override the app container's own connection
# string with this host-side one and the container would try 127.0.0.1:5433,
# where nothing is listening. The npm scripts pass `dbmate --env VANTAGE_DB_URL`.
#
# 5433 is devdata Postgres's published port; inside Docker the app and the
# migrate service use dev-postgres:5432 instead, set in compose.yml.
VANTAGE_DB_URL=postgres://semaisens:secret@127.0.0.1:5433/vantage?sslmode=disable
DBMATE_MIGRATIONS_DIR=db/migrations
DBMATE_SCHEMA_FILE=db/schema.sql

# dbmate dumps db/schema.sql with pg_dump after each migration, and pg_dump may
# not be installed on the host — only inside the dev-postgres container. Skip
# the automatic dump so `dbmate up` doesn't fail on it; run `npm run db:schema`
# to refresh the dump through the container when you want it.
DBMATE_NO_DUMP_SCHEMA=true

# Optional. Empty = no auth, which is the right default while the app is bound
# to loopback. Set a PIN to lock the API; the sync worker then needs the same
# value in its environment. See "Locking the app with a PIN" in the README.
VANTAGE_PIN=
